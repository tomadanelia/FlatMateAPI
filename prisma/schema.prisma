generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = ""
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum Gender {
  WOMAN
  MAN
  NON_BINARY
  OTHER
  PREFER_NOT_TO_SAY
}

enum TestType {
  BIG_FIVE
  HEXACO
  CUSTOM
}

enum QuestionKind {
  LIKERT
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  BOOLEAN
  NUMBER
  TEXT
}

enum IntegrationProvider {
  SPOTIFY
  LETTERBOXD
}

enum IntegrationStatus {
  PENDING
  CONNECTED
  EXPIRED
  ERROR
  DISCONNECTED
}

enum AlgorithmKey {
  PERSONALITY
  TASTE
  LIFESTYLE
}

model User {
  id                 String                 @id @db.Uuid
  email              String                 @unique
  passwordHash       String?                @map("password_hash")
  emailVerifiedAt    DateTime?              @map("email_verified_at")
  role               UserRole               @default(USER)
  displayName        String?                @map("display_name")
  birthDate          DateTime?              @map("birth_date") @db.Date
  gender             Gender?
  bio                String?
  avatarUrl          String?                @map("avatar_url")
  isDiscoverable     Boolean                @default(true) @map("is_discoverable")
  onboardingComplete Boolean                @default(false) @map("onboarding_complete")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  housingPreference  HousingPreference?
  lifestyleProfile   LifestyleProfile?
  testAttempts       TestAttempt[]
  integrations       ExternalIntegration[]
  tasteItems         TasteItem[]
  musicGenres        UserMusicGenre[]
  favoriteArtists    UserArtist[]
  movieGenres        UserMovieGenre[]
  favoriteMovies     UserMovie[]
  conversationsAsOne Conversation[]         @relation("ConversationParticipantOne")
  conversationsAsTwo Conversation[]         @relation("ConversationParticipantTwo")
  sentMessages       Message[]              @relation("MessageSender")
  emailVerification  EmailVerificationCode?
  blocksInitiated    UserBlock[]             @relation("Blocker")
  blocksReceived     UserBlock[]             @relation("Blocked")

  @@index([isDiscoverable, onboardingComplete, gender])
  @@map("users")
}

model UserBlock {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

model EmailVerificationCode {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @map("user_id") @db.Uuid
  codeHash   String   @map("code_hash")
  expiresAt  DateTime @map("expires_at")
  attempts   Int      @default(0)
  lastSentAt DateTime @default(now()) @map("last_sent_at")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("email_verification_codes")
}

model Conversation {
  id               String    @id @default(uuid()) @db.Uuid
  participantOneId String    @map("participant_one_id") @db.Uuid
  participantTwoId String    @map("participant_two_id") @db.Uuid
  lastMessageAt    DateTime? @map("last_message_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  participantOne   User      @relation("ConversationParticipantOne", fields: [participantOneId], references: [id], onDelete: Cascade)
  participantTwo   User      @relation("ConversationParticipantTwo", fields: [participantTwoId], references: [id], onDelete: Cascade)
  messages         Message[]

  @@unique([participantOneId, participantTwoId])
  @@index([participantOneId, lastMessageAt])
  @@index([participantTwoId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  senderId       String       @map("sender_id") @db.Uuid
  body           String
  readAt         DateTime?    @map("read_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt, id])
  @@index([senderId])
  @@map("messages")
}

model HousingPreference {
  id                       String    @id @default(uuid()) @db.Uuid
  userId                   String    @unique @map("user_id") @db.Uuid
  city                     String
  countryCode              String    @map("country_code") @db.Char(2)
  minMonthlyBudget         Int       @map("min_monthly_budget")
  maxMonthlyBudget         Int       @map("max_monthly_budget")
  currency                 String    @default("USD") @db.Char(3)
  moveInDate               DateTime? @map("move_in_date") @db.Date
  preferredAreas           String[]  @default([]) @map("preferred_areas")
  preferredRoommateGenders Gender[]  @default([WOMAN, MAN, NON_BINARY, OTHER, PREFER_NOT_TO_SAY]) @map("preferred_roommate_genders")
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([countryCode, city, currency, minMonthlyBudget, maxMonthlyBudget])
  @@index([preferredRoommateGenders], type: Gin)
  @@map("housing_preferences")
}

model LifestyleProfile {
  id              String  @id @default(uuid()) @db.Uuid
  userId          String  @unique @map("user_id") @db.Uuid
  cleanliness     Int
  socialLevel     Int     @map("social_level")
  sleepSchedule   Int     @map("sleep_schedule")
  noiseTolerance  Int     @map("noise_tolerance")
  guestsFrequency Int     @map("guests_frequency")
  smokingAllowed  Boolean @default(false) @map("smoking_allowed")
  petsAllowed     Boolean @default(true) @map("pets_allowed")
  hasPets         Boolean @default(false) @map("has_pets")
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("lifestyle_profiles")
}

model TestDefinition {
  id          String        @id @default(uuid()) @db.Uuid
  slug        String        @unique
  name        String
  type        TestType
  version     Int           @default(1)
  description String?
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at")
  questions   Question[]
  attempts    TestAttempt[]

  @@unique([type, version])
  @@map("test_definitions")
}

model Question {
  id               String         @id @default(uuid()) @db.Uuid
  testDefinitionId String         @map("test_definition_id") @db.Uuid
  code             String
  prompt           String
  kind             QuestionKind   @default(LIKERT)
  trait            String
  reverseScored    Boolean        @default(false) @map("reverse_scored")
  position         Int
  options          Json?
  minValue         Int?           @map("min_value")
  maxValue         Int?           @map("max_value")
  weight           Float          @default(1)
  testDefinition   TestDefinition @relation(fields: [testDefinitionId], references: [id], onDelete: Cascade)
  responses        TestResponse[]

  @@unique([testDefinitionId, code])
  @@unique([testDefinitionId, position])
  @@map("questions")
}

model TestAttempt {
  id               String         @id @default(uuid()) @db.Uuid
  userId           String         @map("user_id") @db.Uuid
  testDefinitionId String         @map("test_definition_id") @db.Uuid
  completedAt      DateTime?      @map("completed_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  testDefinition   TestDefinition @relation(fields: [testDefinitionId], references: [id])
  responses        TestResponse[]
  traitScores      TraitScore[]

  @@index([userId, completedAt])
  @@map("test_attempts")
}

model TestResponse {
  id         String      @id @default(uuid()) @db.Uuid
  attemptId  String      @map("attempt_id") @db.Uuid
  questionId String      @map("question_id") @db.Uuid
  value      Json
  attempt    TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question   Question    @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
  @@map("test_responses")
}

model TraitScore {
  id        String      @id @default(uuid()) @db.Uuid
  attemptId String      @map("attempt_id") @db.Uuid
  trait     String
  score     Float
  attempt   TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, trait])
  @@map("trait_scores")
}

model ExternalIntegration {
  id                    String              @id @default(uuid()) @db.Uuid
  userId                String              @map("user_id") @db.Uuid
  provider              IntegrationProvider
  externalUserId        String?             @map("external_user_id")
  username              String?
  accessTokenEncrypted  String?             @map("access_token_encrypted")
  refreshTokenEncrypted String?             @map("refresh_token_encrypted")
  tokenExpiresAt        DateTime?           @map("token_expires_at")
  status                IntegrationStatus   @default(PENDING)
  lastSyncedAt          DateTime?           @map("last_synced_at")
  metadata              Json?
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("external_integrations")
}

model TasteItem {
  id         String              @id @default(uuid()) @db.Uuid
  userId     String              @map("user_id") @db.Uuid
  provider   IntegrationProvider
  externalId String              @map("external_id")
  kind       String
  name       String
  artists    String[]            @default([])
  genres     String[]            @default([])
  score      Float               @default(1)
  metadata   Json?
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, externalId, kind])
  @@index([userId, provider])
  @@map("taste_items")
}

model MusicGenre {
  id      String           @id @default(uuid()) @db.Uuid
  name    String           @unique
  artists ArtistGenre[]
  users   UserMusicGenre[]

  @@map("music_genres")
}

model Artist {
  id     String        @id @default(uuid()) @db.Uuid
  name   String        @unique
  genres ArtistGenre[]
  users  UserArtist[]

  @@index([name])
  @@map("artists")
}

model ArtistGenre {
  artistId     String     @map("artist_id") @db.Uuid
  musicGenreId String     @map("music_genre_id") @db.Uuid
  artist       Artist     @relation(fields: [artistId], references: [id], onDelete: Cascade)
  musicGenre   MusicGenre @relation(fields: [musicGenreId], references: [id], onDelete: Cascade)

  @@id([artistId, musicGenreId])
  @@map("artist_genres")
}

model UserMusicGenre {
  userId       String     @map("user_id") @db.Uuid
  musicGenreId String     @map("music_genre_id") @db.Uuid
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  musicGenre   MusicGenre @relation(fields: [musicGenreId], references: [id], onDelete: Cascade)

  @@id([userId, musicGenreId])
  @@map("user_music_genres")
}

model UserArtist {
  userId   String @map("user_id") @db.Uuid
  artistId String @map("artist_id") @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([userId, artistId])
  @@map("user_artists")
}

model MovieGenre {
  id     String           @id @default(uuid()) @db.Uuid
  name   String           @unique
  movies MovieGenreLink[]
  users  UserMovieGenre[]

  @@map("movie_genres")
}

model Movie {
  id     String           @id @default(uuid()) @db.Uuid
  title  String           @unique
  genres MovieGenreLink[]
  users  UserMovie[]

  @@index([title])
  @@map("movies")
}

model MovieGenreLink {
  movieId      String     @map("movie_id") @db.Uuid
  movieGenreId String     @map("movie_genre_id") @db.Uuid
  movie        Movie      @relation(fields: [movieId], references: [id], onDelete: Cascade)
  movieGenre   MovieGenre @relation(fields: [movieGenreId], references: [id], onDelete: Cascade)

  @@id([movieId, movieGenreId])
  @@map("movie_genres_link")
}

model UserMovieGenre {
  userId       String     @map("user_id") @db.Uuid
  movieGenreId String     @map("movie_genre_id") @db.Uuid
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  movieGenre   MovieGenre @relation(fields: [movieGenreId], references: [id], onDelete: Cascade)

  @@id([userId, movieGenreId])
  @@map("user_movie_genres")
}

model UserMovie {
  userId  String @map("user_id") @db.Uuid
  movieId String @map("movie_id") @db.Uuid
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([userId, movieId])
  @@map("user_movies")
}

model AlgorithmConfig {
  id        String       @id @default(uuid()) @db.Uuid
  key       AlgorithmKey @unique
  enabled   Boolean      @default(true)
  weight    Float        @default(1)
  version   String       @default("1.0.0")
  settings  Json         @default("{}")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@map("algorithm_configs")
}
