# Supabase: Project Settings > Database > Connection string (use pooler at runtime)
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Supabase direct connection (used by Prisma migrations)
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@HOST:5432/postgres"
PORT=3000
ADMIN_API_KEY=replace-with-a-long-random-secret
JWT_SECRET=replace-with-an-independent-long-random-secret
JWT_EXPIRES_IN=7d
